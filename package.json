{
    "name": "kuroshiro-analyzer-yahoo-webapi",
    "version": "1.2.1",
    "description": "Yahoo WebAPI morphological analyzer for kuroshiro",
    "main": "index.js",
    "module": "src/index.js",
    "scripts": {
        "lint": "eslint src test index.js *.mjs",
        "lint:fix": "npm run lint -- --fix",
        "jest": "jest --verbose",
        "jest:watch": "npm run jest -- --watch",
        "jest:coverage": "jest --verbose --coverage",
        "test:package": "node test/package-smoke.cjs",
        "test": "npm run lint && npm run jest && npm run build && npm run test:package",
        "clean": "rimraf lib",
        "build": "npm run clean && npm run build:cjs",
        "build:cjs": "cross-env BABEL_ENV=cjs babel src --out-dir lib",
        "prepack": "npm run build",
        "test:live": "node test/live.cjs"
    },
    "keywords": [
        "kuroshiro",
        "morphology",
        "analyzer",
        "yahoo",
        "webapi",
        "api",
        "japanese",
        "language",
        "kanji",
        "hiragana",
        "katakana",
        "romaji",
        "kana"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/hexenq/kuroshiro-analyzer-yahoo-webapi.git"
    },
    "author": "Hexen Qi",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/hexenq/kuroshiro-analyzer-yahoo-webapi/issues"
    },
    "homepage": "https://github.com/hexenq/kuroshiro-analyzer-yahoo-webapi",
    "dependencies": {},
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@eslint/js": "^10.0.1",
        "acorn": "^8.18.0",
        "babel-jest": "^30.5.1",
        "babel-plugin-add-module-exports": "^1.0.4",
        "cross-env": "^10.1.0",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "jest": "^30.5.1",
        "rimraf": "^6.1.3"
    },
    "jest": {
        "transform": {
            "^.+\\.jsx?$": "babel-jest"
        },
        "testEnvironment": "node",
        "testMatch": [
            "**/test/**/*.spec.js"
        ]
    },
    "files": [
        "index.js",
        "lib",
        "src"
    ]
}
